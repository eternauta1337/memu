# Binario wacli (default: `wacli` en PATH).
WACLI_BIN=wacli
# Usuario "dueño" para las CLIs mono-usuario (pair, ask, digest): user del registro central
# (registry.ts) sobre el que operan. Todo lo suyo vive en data/users/<id>/ (memu.db + wacli/).
# El orquestador (`pnpm ingest`) NO lo usa: ahí el userId sale del ruteo del webhook.
MEMU_USER_ID=1
# MEMU_USERS_DIR=./data/users     # base de los directorios por-usuario
# MEMU_REGISTRY_DB=./data/registry.db   # registro central de usuarios

# Teléfono del ADMIN (E.164 sin +) para alertas operativas (deslink/ban de companions o del
# número central). Default: el teléfono del user 1 del registro. Ver alerts.ts.
# MEMU_ADMIN_PHONE=59899XXXXXXX

# Zona horaria en la que razona Memu (reminders, AHORA del prompt, digests). La box corre en UTC;
# env.ts fija este default si no viene del entorno.
# TZ=America/Montevideo

# Pool de follows (multi-tenant): máx `wacli sync --follow` concurrentes + escalonado de
# arranque (anti thundering-herd de reconexiones). Los que exceden el cap se loguean sin follow.
# MEMU_FOLLOW_POOL_SIZE=50        # máx follows concurrentes
# MEMU_FOLLOW_STAGGER_MS=3000     # delay entre arranques de follow

# Cap de media por usuario: si data/users/<id>/wacli/media supera esto, se podan los archivos
# más viejos (los mensajes quedan). 0 = sin cap. Default 500 MB.
# MEMU_MEDIA_CAP_MB=500
# MEMU_MEDIA_CAP_SWEEP_MS=900000  # cada cuánto revisa (15 min)

# LLM — cualquier endpoint OpenAI-compatible con tool calling (un gateway tipo LiteLLM delante
# de un modelo local, o un proveedor hosted).
LLM_BASE_URL=http://127.0.0.1:4000/v1
LLM_API_KEY=
LLM_MODEL=

# Embeddings — TEI (text-embeddings-inference) en GPU, endpoint nativo /embed (NO OpenAI-compat).
# Modelo gte-multilingual-base (768-dim, normalizado, sin prefijos). Corre como contenedor
# docker `memu-embed` con el puerto publicado en host:
#   docker run -d --name memu-embed --gpus all --restart unless-stopped \
#     -p 127.0.0.1:9000:80 -v memu-embed-cache:/data \
#     ghcr.io/huggingface/text-embeddings-inference:cuda-latest \
#     --model-id Alibaba-NLP/gte-multilingual-base --max-client-batch-size 128
EMBED_URL=http://127.0.0.1:9000/embed
# EMBED_TIMEOUT_MS=60000      # timeout por request

# STT — server Speaches (faster-whisper) en GPU, OpenAI-compat /v1/audio/transcriptions.
# Speaches decodifica el audio solo; se le manda el archivo tal cual.
STT_URL=http://127.0.0.1:5001/v1/audio/transcriptions
STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# STT_LANG=es                 # idioma
# STT_TIMEOUT_MS=120000       # timeout por request

# Voz (TTS) — Inworld (API HTTP paga).
INWORLD_API_KEY=              # runtime key de platform.inworld.ai (ya base64, va en Basic)
INWORLD_VOICE_DEFAULT=        # id de voz del workspace de esa key (obligatorio: no hay default)
# INWORLD_TTS_MODEL=inworld-tts-1.5-max       # default
# INWORLD_BASE_URL=https://api.inworld.ai     # default
# INWORLD_SPEAKING_RATE=0.9                   # 0.5–1.5 (1.0=normal, <1=más pausado)
# TTS_TIMEOUT_MS=60000                        # timeout por request

# Ingerir también los chats archivados (default: NO se indexan los archivados).
# MEMU_INGEST_ARCHIVED=1

# Loguear CONTENIDO al journal (texto de mensajes ingeridos, transcripciones STT, preguntas y
# respuestas del bot). Default: NO — el journal es root-readable y persiste fuera de data/;
# sin esto solo se loguea metadata (tipo de chat, dirección, tamaño). Prender solo para debug.
# MEMU_LOG_CONTENT=1

# Stamp que escribe scripts/backup-memu.sh al terminar OK (el destino offsite usa
# `<stamp>-offsite`). index.ts alerta si el local tiene >26 h o el offsite >4 días.
# MEMU_BACKUP_STAMP=./data/backup-stamp
# Apaga ese watchdog entero (para instalaciones sin backups configurados: sin stamp, la
# staleness es infinita y alertaría cada 6 h para siempre).
# MEMU_BACKUP_ALERTS=0

# Cierra el alta de usuarios NUEVOS (control-plane + bot central). Los usuarios que ya existen
# NO se ven afectados: siguen pudiendo re-parearse si se les cae el companion, que pasa por el
# mismo /provision. Un desconocido que escriba al número central recibe un aviso y nada más.
# MEMU_SIGNUPS_ENABLED=0
