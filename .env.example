# Binario wacli (default: `wacli` en PATH). En host-backend está en ~/.local/bin/wacli.
WACLI_BIN=wacli
# Directorio store de wacli (auth + SQLite de whatsmeow). Fase 0: uno solo.
WACLI_STORE=./data/wacli
# DB de Memo (mensajes ingeridos).
MEMO_DB=./data/memo.db

# LLM local (gemma4-31b vía LiteLLM en host-backend; endpoint OpenAI-compatible).
LLM_BASE_URL=http://127.0.0.1:4000/v1
LLM_API_KEY=sk-...            # key de LiteLLM (ver ~/.config/opencode/opencode.json en host-backend)
LLM_MODEL=gemma4-31b

# Embeddings — model server de Onyx en GPU (endpoint propio /encoder/bi-encoder-embed,
# NO OpenAI-compat). Modelo gte-multilingual-base (768-dim, normalizado, sin prefijos).
# La URL default apunta a la IP interna del docker de Onyx (puede cambiar al recrear el stack).
EMBED_URL=http://172.18.0.2:9000/encoder/bi-encoder-embed
EMBED_MODEL=Alibaba-NLP/gte-multilingual-base
# EMBED_MAX_CONTEXT=8192      # tope de contexto por texto
# EMBED_TIMEOUT_MS=60000      # timeout por request

# STT — server Speaches (faster-whisper) en GPU, OpenAI-compat /v1/audio/transcriptions.
# Speaches decodifica el audio solo; se le manda el archivo tal cual.
STT_URL=http://127.0.0.1:5001/v1/audio/transcriptions
STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# STT_LANG=es                 # idioma
# STT_TIMEOUT_MS=120000       # timeout por request

# Voz (TTS) — Inworld (API HTTP paga; misma key/workspace que proyecto-interno).
INWORLD_API_KEY=                              # runtime key de platform.inworld.ai (ya base64, va en Basic)
INWORLD_VOICE_DEFAULT=<voice-id> # voz default (clon rioplatense "la voz")
# INWORLD_TTS_MODEL=inworld-tts-1.5-max       # default
# INWORLD_BASE_URL=https://api.inworld.ai     # default
# INWORLD_SPEAKING_RATE=0.9                   # 0.5–1.5 (1.0=normal, <1=más pausado)
# TTS_TIMEOUT_MS=60000                        # timeout por request
